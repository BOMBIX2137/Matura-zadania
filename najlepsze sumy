#include<iostream>
#include<vector>
#include<climits>
int main() {

	std::vector<int> arr;
	int max = INT_MIN;
	while (true) {
		int n;
		std::cin >> n;
		if (n == 0) {
			break;
		}
		max = std::max(max, n);
		arr.push_back(n);
		
	}

	int maxSum = 0, aktSum = 0;
	for (int i = 0; i < arr.size();i++) {
		aktSum += arr[i];
		if (aktSum > maxSum) {
			maxSum = aktSum;
		}
		if (aktSum < 0) {
			aktSum = 0;
		}
	}
	
	if (maxSum == 0) {
		std::cout << max << std::endl;
		return 0;
	}
	std::cout << maxSum << std::endl;
	return 0;
}
